# WakeUpAgent environment variables
# Copy to .env and change only the values you need.

# Cloud decision layer
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local models
OLLAMA_HOST=http://localhost:11434
MOONDREAM_MODEL=moondream
MOONDREAM_PROMPT=What is the person doing?
LOCAL_CLASSIFIER_MODEL=qwen2.5:1.5b

# Camera and perception
WAKEUP_CAMERA_INDEX=0
WAKEUP_CAPTURE_INTERVAL_SEC=30
WAKEUP_MEDIAPIPE_CONFIDENCE=0.5

# Persistence and memory
WAKEUP_CHECKPOINT_DB_PATH=./superego.db
WAKEUP_DAILY_REPORT_PATH=./memory/daily_reports.md
WAKEUP_CONTEXT_MAX_MESSAGES=20
WAKEUP_SUMMARIZE_THRESHOLD=30
WAKEUP_REACT_MAX_ITERATIONS=5

# Side effects are deliberately opt-in.
WAKEUP_ALLOW_EXTERNAL_MESSAGING=false
WAKEUP_ALLOW_PROCESS_CONTROL=false
