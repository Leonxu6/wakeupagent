# Cyber-Superego — Environment Variables Template
# Copy this file to .env and fill in your real API key
# cp .env.example .env

# DeepSeek API key (used by the cloud decision layer)
# Get yours at: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Potentially disruptive local actions are disabled by default.
# Set a flag to true only after reviewing the corresponding tool behavior.
WAKEUP_ENABLE_WECHAT_ACTIONS=false
WAKEUP_ENABLE_APP_TERMINATION=false
WAKEUP_ENABLE_CHAOS_ACTIONS=false
